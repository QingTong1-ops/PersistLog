{
  "name": "persistlog-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-mode.mjs dev live",
    "dev:mock": "node scripts/run-mode.mjs dev mock",
    "dev:live": "node scripts/run-mode.mjs dev live",
    "build": "node scripts/run-mode.mjs build live",
    "build:mock": "node scripts/run-mode.mjs build mock",
    "build:live": "node scripts/run-mode.mjs build live",
    "start": "node scripts/run-mode.mjs start live",
    "start:mock": "node scripts/run-mode.mjs start mock",
    "start:live": "node scripts/run-mode.mjs start live",
    "test:modes": "node --test tests/modes/*.test.cjs",
    "test:modes:smoke": "node tests/modes/http-smoke.mjs",
    "test:modes:dev": "node tests/modes/dev-smoke.mjs",
    "test:p2": "node --test tests/modes/practice.test.cjs",
    "test:p2:browser": "node tests/practice-browser.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:mock": "tsc --noEmit -p tsconfig.mock.json",
    "typecheck:live": "tsc --noEmit -p tsconfig.live.json"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uwp_components": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "typescript": "^5.9.3"
  }
}
