# Frontend → backend. Browser requests go to same-origin /api/v1 and Next rewrites them.
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_API_URL=http://127.0.0.1:8000

# Show the development page map in production builds (useful for design review only).
NEXT_PUBLIC_SHOW_DEV_NAV=false

# Optional local demo prefill. Leave empty in committed examples.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
