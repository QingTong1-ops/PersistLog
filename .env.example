APP_ENV=dev
DEBUG=false
DATABASE_URL=mysql+pymysql://root:<local-password>@127.0.0.1:3306/persistlog?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:<local-password>@127.0.0.1:3306/persistlog_test?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
ENCRYPTION_KEY=replace-with-fernet-key
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=
# DeepSeek 示例：AI_PROVIDER=deepseek / AI_MODEL=deepseek-flash / AI_BASE_URL=https://api.deepseek.com
AI_BASE_URL=
NOTIFICATION_PROVIDER=wecom
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave unset: prod defaults to true, dev/test to false.
# REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=
STORAGE_BACKEND=local
STORAGE_DIR=storage
TIMEZONE=Asia/Shanghai
DAY_BOUNDARY_HOUR=4
MAX_UPLOAD_BYTES=5242880
