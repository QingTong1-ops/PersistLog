# Backend API base URL. Leave as /api/v1 when using a same-origin reverse proxy.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Keep the current mock data layer for design review; set to false when wiring the API.
NEXT_PUBLIC_USE_MOCK=true

# Show the development page map in production builds (useful for design review only).
NEXT_PUBLIC_SHOW_DEV_NAV=false
