APP_ENV=dev
DEBUG=false
DATABASE_URL=mysql+pymysql://root:<local-password>@127.0.0.1:3306/persistlog?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:<local-password>@127.0.0.1:3306/persistlog_test?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
ENCRYPTION_KEY=replace-with-fernet-key
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=
STORAGE_BACKEND=local
STORAGE_DIR=storage
TIMEZONE=Asia/Shanghai
DAY_BOUNDARY_HOUR=4
MAX_UPLOAD_BYTES=5242880
